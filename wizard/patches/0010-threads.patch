+
+        case "threads":
+            /* the threads service is keyed on the .com tld; rewrite the
+            ** legacy threads.net domain so those links resolve too. */
+            if (host.tld === 'net') {
+                url = new URL(`https://www.threads.com${url.pathname}${url.search}`);
+            }
+            break;
     }
 
     return url;
