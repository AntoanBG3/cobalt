Subject: Fix rewritten HLS headers and catch size probe failures

Adapted from https://github.com/imputnet/cobalt/pull/1611

diff --git a/api/src/stream/internal-hls.js b/api/src/stream/internal-hls.js
index b56c93ffefb83da8d143294c55595fcb1368ddc7..a029185cc1a4e04b41b9fc1bf487b2c905813219 100644
--- a/api/src/stream/internal-hls.js
+++ b/api/src/stream/internal-hls.js
@@ -73,6 +73,30 @@ export async function handleHlsPlaylist(streamInfo, req, res) {
 
     hlsPlaylist = HLS.stringify(hlsPlaylist);
 
+    // the playlist body has been rewritten, so response headers copied
+    // from upstream no longer describe what we're sending. this matters
+    // to ffmpeg: it detects m3u8 playlists by url extension or by
+    // content-type, and it trusts content-range when figuring out the
+    // size of the response. upstream headers (e.g. bluesky's cdn serves
+    // playlists as application/octet-stream) made it refuse to parse
+    // the playlist and output nothing, so we replace them all here.
+    res.status(200);
+    res.setHeader('content-type', 'application/vnd.apple.mpegurl');
+    for (const name of [
+        'transfer-encoding',
+        'trailer',
+        'connection',
+        'keep-alive',
+        'content-range',
+        'content-encoding',
+        'etag',
+        'last-modified',
+        'accept-ranges',
+        'vary'
+    ]) {
+        res.removeHeader(name);
+    }
+
     res.send(hlsPlaylist);
 }
 
diff --git a/api/src/stream/internal.js b/api/src/stream/internal.js
index aa8333aee7fae8c811b47a0feeed6a9cca3757c0..f87896aa25407b1c63e143dc46c3d8845e79f0ad 100644
--- a/api/src/stream/internal.js
+++ b/api/src/stream/internal.js
@@ -166,7 +166,9 @@ export async function probeInternalTunnel(streamInfo) {
         };
 
         if (streamInfo.isHLS) {
-            return probeInternalHLSTunnel({
+            // awaited so a probe rejection (e.g. the 3s timeout) is caught
+            // here instead of failing the download that asked for an estimate
+            return await probeInternalHLSTunnel({
                 ...streamInfo,
                 signal,
                 headers
