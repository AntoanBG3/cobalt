Subject: Ignore a null Facebook HD or SD link instead of matching the next video

Adapted from https://github.com/imputnet/cobalt/pull/1533

diff --git a/api/src/processing/services/facebook.js b/api/src/processing/services/facebook.js
index 1c8ec7d..ca152e5 100644
--- a/api/src/processing/services/facebook.js
+++ b/api/src/processing/services/facebook.js
@@ -97,11 +97,11 @@ export default async function({ id, shareType, shortLink, photoId, dispatcher })
     if (!html) return { error: "fetch.fail" };
 
     const urls = [];
-    const hd = html.match('"browser_native_hd_url":(".*?")');
-    const sd = html.match('"browser_native_sd_url":(".*?")');
+    const hd = html.match('"browser_native_hd_url":(null|".*?")');
+    const sd = html.match('"browser_native_sd_url":(null|".*?")');
 
-    if (hd?.[1]) urls.push(JSON.parse(hd[1]));
-    if (sd?.[1]) urls.push(JSON.parse(sd[1]));
+    if (hd?.[1] && hd[1] !== 'null') urls.push(JSON.parse(hd[1]));
+    if (sd?.[1] && sd[1] !== 'null') urls.push(JSON.parse(sd[1]));
 
     if (!urls.length) {
         return { error: "fetch.empty" };
