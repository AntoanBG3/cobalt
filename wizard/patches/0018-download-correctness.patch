diff --git a/api/test/download-correctness.test.js b/api/test/download-correctness.test.js
new file mode 100644
index 00000000..3b4ce2a3
--- /dev/null
+++ b/api/test/download-correctness.test.js
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { createServer } from "node:http";
+import { after, test } from "node:test";
+import express from "express";
+import { Agent, setGlobalDispatcher } from "undici";
+import { setTunnelPort } from "../src/config.js";
+import { internalStream } from "../src/stream/internal.js";
+import { createInternalStream, getInternalTunnel } from "../src/stream/manage.js";
+import stream from "../src/stream/stream.js";
+
+const dispatcher = new Agent();
+setGlobalDispatcher(dispatcher);
+after(() => dispatcher.destroy());
+
+async function serve(t, configure) {
+    const app = express();
+    const server = createServer(app);
+    server.listen(0);
+    t.after(() => {
+        server.close();
+        server.closeAllConnections();
+    });
+    await once(server, 'listening');
+    const { port } = server.address();
+    setTunnelPort(port);
+    const origin = `http://localhost:${port}`;
+    app.get('/itunnel', (req, res) => internalStream(getInternalTunnel(req.query.id), res));
+    configure(app, origin);
+    return origin;
+}
+
+test('closing a download before the origin sends headers cancels the origin request', async t => {
+    let started, closed;
+    const opened = new Promise(resolve => { started = resolve; });
+    const completed = new Promise(resolve => { closed = resolve; });
+    const origin = await serve(t, (app, origin) => {
+        app.get('/origin', (_, res) => {
+            const fallback = setTimeout(() => res.end('late file'), 700);
+            res.once('close', () => {
+                clearTimeout(fallback);
+                closed(res.writableFinished);
+            });
+            started();
+        });
+        app.get('/download', (_, res) => stream(res, {
+            type: 'proxy', urls: createInternalStream(origin + '/origin', { headers: {} }),
+            filename: 'video.mp4',
+        }));
+    });
+    const controller = new AbortController();
+    const pending = assert.rejects(fetch(origin + '/download', { signal: controller.signal }), {
+        name: 'AbortError',
+    });
+    await opened;
+    controller.abort();
+    await pending;
+    assert.equal(await completed, false);
+});
+
+test('an origin disconnect during a chunked download fails the transfer', async t => {
+    let interrupt;
+    const origin = await serve(t, (app, origin) => {
+        app.get('/origin', (_, res) => {
+            interrupt = () => res.destroy();
+            res.type('video/mp4').write('partial');
+        });
+        app.get('/download', (_, res) => stream(res, {
+            type: 'proxy', urls: createInternalStream(origin + '/origin', { headers: {} }),
+            filename: 'video.mp4',
+        }));
+    });
+    const response = await fetch(origin + '/download');
+    const reader = response.body.getReader();
+    assert.equal(Buffer.from((await reader.read()).value).toString(), 'partial');
+    interrupt();
+    await assert.rejects(reader.read());
+});
+
+test('checks the upstream range before forwarding bytes', async t => {
+    const origin = await serve(t, app => {
+        app.get('/video', (req, res) => {
+            if (req.method === 'HEAD') {
+                return res.set('Content-Length', '32').end();
+            }
+            res.status(206).set('Content-Range', 'bytes 32-63/64').send('x'.repeat(32));
+        });
+    });
+    const response = await fetch(createInternalStream(origin + '/video', { service: 'youtube' }));
+    assert.equal(response.status, 500);
+    await response.arrayBuffer();
+});
+
+test('accepts a valid partial response with chunked framing', async t => {
+    const origin = await serve(t, app => {
+        app.get('/video', (req, res) => {
+            if (req.method === 'HEAD') {
+                return res.set('Content-Length', '7').end();
+            }
+            res.status(206).set('Content-Range', 'bytes 0-6/7').write('fixture');
+            res.end();
+        });
+    });
+    const response = await fetch(createInternalStream(origin + '/video', { service: 'youtube' }));
+    assert.equal(response.status, 200);
+    assert.equal(await response.text(), 'fixture');
+});
+
+for (const [name, contentType, path, service] of [
+    ['redirected playlists resolve children against the final URL', 'application/vnd.apple.mpegurl', '/redirect'],
+    ['playlist media types accept casing and content-type parameters', 'Application/Vnd.Apple.Mpegurl; charset=utf-8', '/cdn/list.m3u8'],
+    ['Bluesky playlists tolerate query strings with an incorrect media type', 'application/octet-stream', '/cdn/list.m3u8?signed=fixture', 'bsky'],
+]) {
+    test(name, async t => {
+        const origin = await serve(t, app => {
+            app.get('/redirect', (_, res) => res.redirect('/cdn/list.m3u8'));
+            app.get('/cdn/list.m3u8', (_, res) => res.set('Content-Type', contentType).end(
+                '#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXTINF:4,\nsegment.ts\n#EXT-X-ENDLIST\n',
+            ));
+            app.get('/cdn/segment.ts', (_, res) => res.send('fixture segment'));
+        });
+        const response = await fetch(createInternalStream(
+            origin + path, { headers: {}, service },
+        ));
+        assert.equal(response.status, 200);
+        const playlist = await response.text();
+        const media = playlist.split('\n').find(line => line && !line.startsWith('#'));
+        assert.equal(new URL(media).pathname, '/itunnel');
+        const segment = await fetch(media);
+        assert.equal(segment.status, 200);
+        assert.equal(await segment.text(), 'fixture segment');
+    });
+}
diff --git a/api/test/ffmpeg-failure.test.js b/api/test/ffmpeg-failure.test.js
new file mode 100644
index 00000000..eb864080
--- /dev/null
+++ b/api/test/ffmpeg-failure.test.js
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import express from "express";
+
+test('a failed FFmpeg process fails its partially streamed attachment', async t => {
+    const dir = await mkdtemp(join(tmpdir(), 'cobalt-render-'));
+    t.after(() => rm(dir, { recursive: true, force: true }));
+    process.env.FFMPEG_BIN = join(dir, 'ffmpeg');
+    // Simulate a renderer that starts an attachment and then cannot finish it.
+    await writeFile(process.env.FFMPEG_BIN, `#!${process.execPath}
+const { writeSync } = require('node:fs');
+writeSync(3, 'partial output');
+setTimeout(() => { process.exitCode = 1; }, 250);
+`, { mode: 0o755 });
+    const { default: ffmpeg } = await import("../src/stream/ffmpeg.js");
+    const app = express();
+    app.get('/download', (_, res) => ffmpeg.convertAudio({
+        urls: 'https://example.invalid/input.wav', filename: 'file.mp3', audioFormat: 'mp3',
+    }, res));
+    const server = createServer(app);
+    server.listen(0, '127.0.0.1');
+    t.after(() => {
+        server.close();
+        server.closeAllConnections();
+    });
+    await once(server, 'listening');
+    const response = await fetch(`http://127.0.0.1:${server.address().port}/download`);
+    const reader = response.body.getReader();
+    assert.equal(Buffer.from((await reader.read()).value).toString(), 'partial output');
+    await assert.rejects(reader.read());
+});
